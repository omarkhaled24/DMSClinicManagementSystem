@model ClinicManagementBLL.ViewModels.PatientViewModel.CreatePatient

@{
    ViewData["Title"] = "Create Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";


}

<div class="container mt-4">
    <h3 class="text-primary-color mb-4"> Add New Appointment</h3>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


    <form asp-action="CreateAppointment" method="post">
        <div class="mb-3">
            <h5 class="text-primary fw-bold"> Patient Information </h5>
            <hr />
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                <span asp-validation-for="DateOfBirth" class="text-danger" ></span>
            </div>

            <!-- Gender -->
            <div class="col-md-6">
                <label asp-for="Gender" class="form-label fw-semibold"></label>

                <select asp-for="Gender" class="form-select rounded-3">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>

                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

        </div>

        <div class="mb-3 mt-4">
            <h5 class="text-primary fw-bold"> Address Information </h5>
            <hr />
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="BuildingNumber" class="form-label"></label>
                <input asp-for="BuildingNumber" type="number" class="form-control" />
                <span asp-validation-for="BuildingNumber" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="FloorNumber" class="form-label"></label>
                <input asp-for="FloorNumber" type="number" class="form-control" />
                <span asp-validation-for="FloorNumber" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Street" class="form-label"></label>
                <input asp-for="Street" class="form-control" />
                <span asp validation-for="Street" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 mt-4">
            <h5 class="text-primary fw-bold"> Appointment Information </h5>
            <hr />
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="DoctorId" class="form-label"></label>
                <select asp-for="DoctorId" class="form-control" asp-items="@(new SelectList(Model.Doctors, "Id", "Name"))">
                    <option value="">-- Select Doctor --</option>
                </select>
                <span asp-validation-for="DoctorId" class="text-danger">
                </span>
            </div>
            <div class="col-md-6">
                <label asp-for="AppointmentDate" class="form-label"></label>
                <input asp-for="AppointmentDate" type="date" class="form-control" id="AppointmentDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mt-3">
                <label asp-for="SelectedTime" class="form-label"></label>
                <select asp-for="SelectedTime" class="form-control" id="SelectedTime">
                    <option value=""> --Select Time Slot --</option>
                </select>
                <span asp-validation-for="SelectedTime" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-5 d-flex justify-content-between align-items-center">

            <!-- Button -->
           
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary mt-3">
                Back To Home
            </a>

            <div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="reset" class="btn btn-secondary">
                        Reset
                    </button>

                    <button type="submit" class="btn btn-success rounded-3 px-5">
                        Save Appointment
                    </button>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {

            function loadSlots() {

                var doctorId = $("#DoctorId").val();
                var date = $("#AppointmentDate").val();

                var $slot = $("#SelectedTime");

                $slot.empty();
                $slot.append($('<option>').val("").text("-- Select Time Slot --"));

                $("#dateError").remove();
                $("#saveBtn").prop("disabled", false);

                if (!doctorId || !date)
                    return;

                // Prevent Old Date 
                var selectedDate = new Date(date);
                var today = new Date();
                today.setHours(0, 0, 0, 0);

                if (selectedDate < today) {

                    $("#AppointmentDate").after(
                        '<span id="dateError" class="text-danger d-block">' +
                        'Cannot select a past date' +
                        '</span>'
                    );

                    $("#saveBtn").prop("disabled", true);
                    return; 
                }

                // If Date Is Correct Continue 
                $.getJSON('@Url.Action("GetAvailableSlots", "Secretary")',
                    { doctorId: doctorId, date: date },
                    function (data) {

                        if (data.isOff) {

                            $("#AppointmentDate").after(
                                '<span id="dateError" class="text-danger d-block">' +
                                data.message +
                                '</span>'
                            );

                            $("#saveBtn").prop("disabled", true);
                            return;
                        }

                        $.each(data.slots, function (i, time) {
                            $slot.append($('<option>').val(time).text(time));
                        });
                    });
            }

            $("#DoctorId, #AppointmentDate").change(loadSlots);
        });
                $("form").on("reset", function () {

            var form = $(this);

            form.validate().resetForm();

            form.find(".input-validation-error")
                .removeClass("input-validation-error");

            form.find(".field-validation-error")
                .removeClass("field-validation-error")
                .addClass("field-validation-valid")
                .empty();

        });

    </script>

                        }
