@model List<ClinicManagementBLL.ViewModels.PatientViewModel.PatientAppointmentList>

@{
    ViewData["Title"] = "Patients";
    var doctors = ViewBag.Doctors as List<ClinicManagemnetDAL.Models.Doctor>;
}

<div class="container mt-5">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-primary-color">Patients With Appointments</h3>
        <a asp-action="CreateAppointment" class="btn btn-success rounded-3 px-5">
            + Create Appointment
        </a>
    </header>

    <!-- ================== Filter ================== -->
    <form method="get" class="row g-3 mb-4 align-items-end">
        <div class="col-md-3">
            <label for="searchName" class="form-label">Name</label>
            <input type="text" id="searchName" name="searchName" class="form-control"
                   placeholder="Enter patient name"
                   value="@(ViewData["searchName"] ?? "")" />
        </div>

        <div class="col-md-3">
            <label for="dateFilter" class="form-label">Appointment Date</label>
            <input type="date" id="dateFilter" name="dateFilter" class="form-control"
                   value="@(ViewData["dateFilter"] ?? "")" />
        </div>

        <div class="col-md-3">
            <label for="doctorFilter" class="form-label">Doctor</label>
            <select id="doctorFilter" name="doctorFilter" class="form-select">
                <option value="">-- All Doctors --</option>
                @if (doctors != null)
                {
                    foreach (var doc in doctors)
                    {
                        if (ViewData["doctorFilter"]?.ToString() == doc.Id.ToString())
                        {
                            <option value="@doc.Id" selected>@doc.Name</option>
                        }
                        else
                        {
                            <option value="@doc.Id">@doc.Name</option>
                        }
                    }
                }

            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Search / Filter</button>
        </div>
    </form>

    <!-- ================== Table ================== -->
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-borderless table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Patient Name</th>
                        <th>Doctor</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Appointment Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.PatientName</td>
                            <td>@item.DoctorName</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td>@item.AppointmentDate.ToString("MM/dd/yyyy")</td>
                            <td class="d-flex gap-1">
                                <a asp-action="PatientDetails" asp-route-id="@item.PatientId" class="btn btn-info btn-sm">
                                    View
                                </a>
                                <a asp-action="EditPatient" asp-route-id="@item.PatientId" class="btn btn-primary btn-sm">
                                    Edit
                                </a>
                                <form asp-action="DeletePatient" asp-route-id="@item.PatientId" method="post" class="m-0">
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this patient?')">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("PatientsWithAppointments", "Secretary", new { page = i, searchName = ViewBag.SearchName, dateFilter = ViewBag.DateFilter, doctorFilter = ViewBag.DoctorFilter })">
                            @i
                        </a>
                    </li>
                }
            </ul>


        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-person-workspace display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Patients Available</h4>
            <p class="text-muted">Add your first Appointment to get started</p>
        </div>
    }
</div>

@section Scripts
{
    <script>
        // Optional: alert fadeout
        setTimeout(() => {
            const alert = document.getElementById('Alert');
            if(alert) alert.remove();
        }, 5000);
    </script>
}
