@model ClinicManagemnetDAL.Models.Appointment

@{
    ViewData["Title"] = "New Appointment Details";
}

<div class="container mt-4">
    <h3 class="text-primary-color mb-4">New Appointment Created</h3>

    <div class="alert alert-success">
        Appointment has been successfully created!
    </div>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Patient Name</th>
                <th>Doctor Name</th>
                <th>Date</th>
                <th>Time</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Visit Length</th>
                <th>Secretary</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.Patient.Name</td>
                <td>@Model.Doctor.Name</td>
                <td>@Model.AppointmentDate.ToString("yyyy-MM-dd")</td>
                <td>@Model.StartTime.ToString(@"hh\:mm")</td>
                <td>@Model.Patient.PhoneNumber</td>
                <td>@Model.Patient.Email</td>
                <td>@Model.VisitLength min</td>
                <td>@Model.Secretary.Name</td>
            </tr>
        </tbody>
    </table>

    <a href="@Url.Action("CreateAppointment", "Secretary")" class="btn btn-primary mt-3">Add Another Appointment</a>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Back To Home</a>
    <a asp-controller="Secretary"
       asp-action="EditPatient"
       asp-route-id="@Model.Patient.Id"
       class="btn btn-primary mt-3">
        Edit
    </a>
</div>
